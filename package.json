{
  "name": "committee",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "cli": "pnpm --filter @committee/cli cli",
    "dev": "pnpm --filter @committee/cli cli serve",
    "docs:dev": "pnpm --filter @committee/docs dev",
    "docs:build": "pnpm --filter @committee/docs build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
