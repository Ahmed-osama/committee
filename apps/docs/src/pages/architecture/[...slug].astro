---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const topics = await getCollection('architecture');
  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

interface Props {
  topic: CollectionEntry<'architecture'>;
}

const { topic } = Astro.props;
const { Content } = await topic.render();

const allTopics = (await getCollection('architecture')).sort((a, b) => {
  if (a.slug === b.slug) return 0;
  const sa = a.slug.split('/')[0];
  const sb = b.slug.split('/')[0];
  if (sa !== sb) return sa.localeCompare(sb);
  return a.data.order - b.data.order;
});
const index = allTopics.findIndex((t) => t.slug === topic.slug);
const prev = index > 0 ? allTopics[index - 1] : null;
const next = index < allTopics.length - 1 ? allTopics[index + 1] : null;
---

<BaseLayout title={topic.data.title}>
  <div class="chip">{topic.data.title.toUpperCase()}</div>
  <article class="topic">
    <Content />
  </article>
  <nav class="prev-next">
    {prev ? <a href={`/architecture/${prev.slug}`}>&larr; {prev.data.title}</a> : <span />}
    {next ? <a href={`/architecture/${next.slug}`}>{next.data.title} &rarr;</a> : <span />}
  </nav>

  <style>
    .topic { margin-top: 18px; }
    .topic :global(p) { font-size: 15.5px; max-width: 660px; color: #2b2b2b; }

    .prev-next {
      display: flex; justify-content: space-between; gap: 20px;
      margin-top: 60px; padding-top: 20px; border-top: 1px dashed #ddd6c4;
    }
    .prev-next a {
      font-weight: 700; font-size: 14px; color: var(--ink); text-decoration: none;
      max-width: 45%;
    }
    .prev-next a:hover { text-decoration: underline; }
  </style>

  <script>
    import { enrichCodeBlocks } from '../../scripts/enrich-code-blocks';
    enrichCodeBlocks();
  </script>
</BaseLayout>
