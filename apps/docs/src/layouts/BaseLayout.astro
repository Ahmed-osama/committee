---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
}

const { title } = Astro.props;

const topics = await getCollection('architecture');
const sectionOrder = ['overview', 'core', 'db', 'apps', 'groundtruth'];
const sectionLabels: Record<string, string> = {
  overview: 'Overview',
  core: 'packages/core',
  db: 'packages/db',
  apps: 'apps/*',
  groundtruth: 'GroundTruth',
};
const swatchBySection: Record<string, string> = {
  overview: 'var(--coral)',
  core: 'var(--blue)',
  db: 'var(--cream)',
  apps: 'var(--green)',
  groundtruth: 'var(--purple)',
};

function sectionOf(slug: string) {
  return slug.split('/')[0];
}

const bySection = new Map<string, typeof topics>();
for (const section of sectionOrder) bySection.set(section, []);
for (const topic of topics.sort((a, b) => a.data.order - b.data.order)) {
  const section = sectionOf(topic.slug);
  if (!bySection.has(section)) bySection.set(section, []);
  bySection.get(section)!.push(topic);
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — committee docs</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style is:global>
    :root {
      --ink: #1a1a1a;
      --blue: #5b9bd5;      --blue-dk: #3f7cb8;
      --cream: #f5e2cf;     --cream-dk: #d9bd98;
      --green: #8fc9a0;     --green-dk: #5fa374;
      --yellow: #f4d35e;    --yellow-dk: #d1ab2e;
      --coral: #f2836b;     --coral-dk: #d45f45;
      --purple: #b8a4d4;    --purple-dk: #8f77b3;
      --paper: #ffffff;
      --bg: #f6f5f2;
      --muted: #6b6b6b;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: 'Nunito', -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      line-height: 1.6;
    }
    h1, h2, h3, .display { font-family: 'Baloo 2', 'Nunito', sans-serif; }
    code {
      background: #efe9da;
      padding: 2px 7px;
      border-radius: 5px;
      font-size: 0.88em;
      font-family: "SF Mono", Menlo, monospace;
    }
    pre {
      background: #1e1e1e;
      color: #eee;
      padding: 14px 16px;
      border-radius: 10px;
      overflow-x: auto;
      font-size: 13px;
    }
    pre code { background: none; padding: 0; }

    /* Shiki-highlighted fenced code blocks get wrapped client-side in
       .code-block (header + copy button) — see src/scripts/enrich-code-blocks.ts. */
    .code-block {
      max-width: 720px;
      margin: 20px 0;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.35);
    }
    .code-block-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #1c1f26;
      padding: 8px 14px;
      border-bottom: 1px solid #33394a;
    }
    .code-block-lang {
      font-family: 'Baloo 2', sans-serif;
      font-weight: 700;
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #9aa4b8;
    }
    .code-block-copy {
      font-family: 'Nunito', sans-serif;
      font-weight: 700;
      font-size: 12px;
      color: #cfd6e4;
      background: #2a2f3c;
      border: 1px solid #3a4054;
      border-radius: 999px;
      padding: 4px 12px;
      cursor: pointer;
    }
    .code-block-copy:hover { background: #343b4c; }
    .code-block-copy.copied { background: var(--green-dk); border-color: var(--green-dk); color: #fff; }
    .code-block pre.astro-code {
      margin: 0;
      border-radius: 0;
      padding: 16px 18px;
      font-size: 13px;
    }
    .art {
      background: var(--paper);
      border: 1px solid #ece7d9;
      box-shadow: 0 10px 28px -14px rgba(0,0,0,0.18);
      border-radius: 20px;
      padding: 22px;
      margin-top: 22px;
      display: inline-block;
    }
    .art svg { display: block; max-width: 100%; height: auto; }
    .chip {
      display: inline-flex;
      align-items: center;
      background: var(--ink);
      color: #fff;
      font-family: 'Baloo 2', sans-serif;
      font-weight: 700;
      font-size: 16px;
      letter-spacing: 0.01em;
      padding: 6px 18px;
      border-radius: 999px;
    }
  </style>
  <style>
    .layout { display: flex; min-height: 100vh; }
    nav.sidebar {
      width: 260px;
      flex-shrink: 0;
      background: var(--paper);
      border-right: 1px solid #e7e3db;
      padding: 30px 18px;
      position: sticky;
      top: 0;
      align-self: flex-start;
      height: 100vh;
      overflow-y: auto;
    }
    nav.sidebar .brand { display: flex; align-items: baseline; gap: 8px; margin: 0 8px 4px; }
    nav.sidebar .brand a { color: inherit; text-decoration: none; }
    nav.sidebar h1 { font-size: 21px; font-weight: 800; margin: 0; letter-spacing: -0.01em; }
    nav.sidebar .tagline { font-size: 12px; color: var(--muted); margin: 2px 8px 22px; }
    nav.sidebar .section-label {
      font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;
      color: var(--muted); margin: 18px 8px 6px;
    }
    nav.sidebar ul { list-style: none; margin: 0; padding: 0; }
    nav.sidebar li { margin-bottom: 3px; }
    nav.sidebar a {
      display: flex; align-items: center; gap: 10px; padding: 8px 12px;
      border-radius: 10px; color: #333; text-decoration: none;
      font-size: 13.5px; font-weight: 700; transition: background 0.12s ease;
    }
    nav.sidebar a .swatch { width: 10px; height: 10px; border-radius: 3px; border: 2px solid var(--ink); flex-shrink: 0; }
    nav.sidebar a:hover { background: #f2eee4; }
    nav.sidebar a.active { background: #efe9da; }
    main { flex: 1; max-width: 920px; padding: 54px 60px 140px; }
  </style>
</head>
<body>
<div class="layout">
  <nav class="sidebar">
    <div class="brand"><a href="/"><h1>committee</h1></a></div>
    <p class="tagline">curriculum docs — regenerated as the code changes</p>
    <ul>
      <li><a href="/journal"><span class="swatch" style="background:var(--yellow)"></span>📚 Learning journal</a></li>
    </ul>
    {sectionOrder.filter((s) => (bySection.get(s) ?? []).length > 0).map((section) => (
      <>
        <div class="section-label">{sectionLabels[section]}</div>
        <ul>
          {bySection.get(section)!.map((topic) => (
            <li>
              <a href={`/architecture/${topic.slug}`}>
                <span class="swatch" style={`background:${swatchBySection[section]}`}></span>
                {topic.data.title}
              </a>
            </li>
          ))}
        </ul>
      </>
    ))}
  </nav>
  <main>
    <slot />
  </main>
</div>
</body>
</html>
