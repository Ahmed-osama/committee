# Copy to .env at the repo root (gitignored) and fill in whichever keys you have.
# Ollama needs none of these — it's local. The router skips any provider
# whose key is missing, so it's fine to leave some of these blank.

GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
# GLM_BASE_URL=https://api.z.ai/api   # only if your key is from the international z.ai site, not bigmodel.cn
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=

# Optional safety ceilings (see packages/core/src/provider/provider-router.ts)
# COMMITTEE_DAILY_CALL_CEILING=200
# COMMITTEE_DAILY_SPEND_USD_CEILING=5

# GroundTruth (apps/web, packages/db) — Neon Postgres.
# Pooled connection (pgbouncer). Used by apps/web and packages/db's runtime clients
# (`db` and `pooledDb` in packages/db/src/client.ts).
DATABASE_URL="postgres://user:password@ep-example-pooler.region.aws.neon.tech/committee?sslmode=require"

# Unpooled/direct connection. Used ONLY by packages/db's migration scripts
# (pnpm db:generate / pnpm db:migrate) — pgbouncer's pooling breaks Drizzle's
# migration locking.
DATABASE_URL_UNPOOLED="postgres://user:password@ep-example.region.aws.neon.tech/committee?sslmode=require"
